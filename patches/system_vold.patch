+// Prefix for keys in the legacy process keyring (fscrypt v1 on 4.14 kernels)
+static const char* const kKeyPrefixes[] = {"ext4", "f2fs", "fscrypt", nullptr};
+
+static bool fscryptKeyring(int32_t* device_keyring) {
+    long id = syscall(__NR_keyctl, KEYCTL_SEARCH, KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0);
+    if (id < 0) {
+        id = syscall(__NR_keyctl, KEYCTL_SEARCH, KEY_SPEC_USER_SESSION_KEYRING, "keyring",
+                     "fscrypt", 0);
+    }
+    if (id < 0) {
+        PLOG(ERROR) << "Unable to find device keyring";
+        return false;
+    }
+    *device_keyring = static_cast<int32_t>(id);
+    return true;
+}
+
+static bool installKeyLegacy(const KeyBuffer& key, const std::string& raw_ref) {
+    // Place fscrypt_key into automatically zeroing buffer.
+    KeyBuffer fs_key_buf(sizeof(fscrypt_key));
+    fscrypt_key& fs_key = *reinterpret_cast<fscrypt_key*>(fs_key_buf.data());
+
+    if (key.size() > sizeof(fs_key.raw)) {
+        LOG(ERROR) << "Key too long: " << key.size();
+        return false;
+    }
+    fs_key.mode = FS_ENCRYPTION_MODE_AES_256_XTS;
+    fs_key.size = key.size();
+    memset(fs_key.raw, 0, sizeof(fs_key.raw));
+    memcpy(fs_key.raw, key.data(), key.size());
+
+    int32_t device_keyring;
+    if (!fscryptKeyring(&device_keyring)) return false;
+    std::string ref = keyrefstring(raw_ref);
+    for (unsigned int i = 0; kKeyPrefixes[i] != nullptr; i++) {
+        std::string keyref = std::string(kKeyPrefixes[i]) + ":" + ref;
+        long key_id = syscall(__NR_add_key, "logon", keyref.c_str(), &fs_key, sizeof(fs_key),
+                              device_keyring);
+        if (key_id < 0) {
+            PLOG(ERROR) << "Failed to insert key into keyring " << device_keyring;
+            return false;
+        }
+        LOG(DEBUG) << "Added key " << key_id << " (" << keyref << ") to keyring " << device_keyring
+                   << " in process " << getpid();
+    }
+    return true;
+}
