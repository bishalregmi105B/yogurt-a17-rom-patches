+static void DumpKmsgToMetadata(const std::string& reason) {
+    int out_fd = open("/metadata/bootstat/kmsg_dump.txt", O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+    if (out_fd < 0) return;
+    std::string header = "\n=== DIAG: " + reason + " ===\n";
+    if (!android::base::WriteFully(out_fd, header.data(), header.size())) {
+        close(out_fd);
+        return;
+    }
+    int kmsg_fd = open("/dev/kmsg", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (kmsg_fd >= 0) {
+        char buf[4096];
+        int count = 0;
+        while (count < 4000) {
+            ssize_t n = read(kmsg_fd, buf, sizeof(buf));
+            if (n <= 0) break;
+            if (!android::base::WriteFully(out_fd, buf, n)) break;
+            count++;
+        }
+        close(kmsg_fd);
+    }
+    fsync(out_fd);
+    close(out_fd);
+    sync();
+}
+
 void Service::Reap(const siginfo_t& siginfo) {
+    if ((siginfo.si_code != CLD_EXITED || siginfo.si_status != 0) && on_failure_reboot_target_) {
+        DumpKmsgToMetadata("Reap service=" + name_ + " target=" + *on_failure_reboot_target_ +
+                           " si_code=" + std::to_string(siginfo.si_code) +
+                           " si_status=" + std::to_string(siginfo.si_status));
+    }
     if (!(flags_ & SVC_ONESHOT) || (flags_ & SVC_RESTART)) {
         KillProcessGroup(SIGKILL);
     } else {
