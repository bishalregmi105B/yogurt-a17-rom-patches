+    // If recovery wiped /data as ext4 (without fscrypt support) when fstab expects f2fs,
+    // zero the ext4 superblock so fs_mgr_mount_all detects partition_wiped() and formats f2fs.
+    for (const auto& entry : fstab) {
+        if (entry.mount_point == "/data" && entry.fs_type == "f2fs" &&
+            entry.fs_mgr_flags.formattable) {
+            android::base::unique_fd fd(
+                    TEMP_FAILURE_RETRY(open(entry.blk_device.c_str(), O_RDWR | O_CLOEXEC)));
+            if (fd.get() >= 0) {
+                uint16_t magic = 0;
+                if (pread(fd.get(), &magic, sizeof(magic), 1024 + 0x38) == sizeof(magic) &&
+                    magic == 0xEF53) {
+                    LOG(WARNING) << "Detected recovery ext4 superblock on f2fs /data ("
+                                 << entry.blk_device << "); zeroing superblock for f2fs format";
+                    std::vector<uint8_t> zeros(65536, 0);
+                    pwrite(fd.get(), zeros.data(), zeros.size(), 0);
+                    fsync(fd.get());
+                }
+            }
+        }
+    }
+
     auto mount_fstab_result = fs_mgr_mount_all(&fstab, mount_all->mode);
