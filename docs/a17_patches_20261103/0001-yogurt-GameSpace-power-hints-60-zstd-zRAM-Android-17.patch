     frameworks/native/data/etc/android.hardware.audio.low_latency.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.audio.low_latency.xml \
     frameworks/native/data/etc/android.hardware.bluetooth.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.bluetooth.xml \
     frameworks/native/data/etc/android.hardware.bluetooth_le.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.bluetooth_le.xml \
diff --git a/rootdir/etc/fstab.mt6768 b/rootdir/etc/fstab.mt6768
index 77a460a..cf5806e 100644
--- a/rootdir/etc/fstab.mt6768
+++ b/rootdir/etc/fstab.mt6768
@@ -6,17 +6,17 @@
 # Currently we dont have e2fsck compiled. So fs check would failed.
 
 # Core Partitions
-system /system ext4 ro wait,,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-developer-gsi.avbpubkey:/avb/r-developer-gsi.avbpubkey:/avb/s-developer-gsi.avbpubkey,readahead_size_kb=128
-vendor /vendor ext4 ro wait,,avb,logical,first_stage_mount,readahead_size_kb=128
-product /product ext4 ro wait,,avb,logical,first_stage_mount
+system /system ext4 ro wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-developer-gsi.avbpubkey:/avb/r-developer-gsi.avbpubkey:/avb/s-developer-gsi.avbpubkey,readahead_size_kb=128
+vendor /vendor ext4 ro wait,avb,logical,first_stage_mount,readahead_size_kb=128
+product /product ext4 ro wait,avb,logical,first_stage_mount
 /dev/block/platform/bootdevice/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065 wait,check,formattable,reservedsize=128m,latemount,checkpoint=fs,fileencryption=aes-256-xts,readahead_size_kb=128
 /dev/block/platform/bootdevice/by-name/cache /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable
 /dev/block/platform/bootdevice/by-name/dtbo /dtbo emmc defaults defaults
 /dev/block/platform/bootdevice/by-name/vbmeta /vbmeta emmc defaults defaults
-/dev/block/platform/bootdevice/by-name/recovery /recovery emmc defaults first_stage_mount,nofail,
-/dev/block/platform/bootdevice/by-name/boot /boot emmc defaults first_stage_mount,nofail,
-/dev/block/platform/bootdevice/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults first_stage_mount,nofail,
-/dev/block/platform/bootdevice/by-name/vbmeta_system /vbmeta_system emmc defaults first_stage_mount,nofail,,avb=vbmeta
+/dev/block/platform/bootdevice/by-name/recovery /recovery emmc defaults first_stage_mount,nofail
+/dev/block/platform/bootdevice/by-name/boot /boot emmc defaults first_stage_mount,nofail
+/dev/block/platform/bootdevice/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults first_stage_mount,nofail
+/dev/block/platform/bootdevice/by-name/vbmeta_system /vbmeta_system emmc defaults first_stage_mount,nofail,avb=vbmeta
 
 # Misc Partitions
 /dev/block/platform/bootdevice/by-name/md_udc /metadata ext4 noatime,nosuid,nodev,discard wait,formattable,first_stage_mount
@@ -52,4 +52,4 @@ product /product ext4 ro wait,,avb,logical,first_stage_mount
 /dev/block/platform/bootdevice/by-name/otp /otp emmc defaults defaults
 
 # zRAM
-/dev/block/zram0 none swap defaults zramsize=100%,max_comp_streams=8
+/dev/block/zram0 none swap defaults zramsize=60%,max_comp_streams=8
diff --git a/rootdir/etc/init.ago.rc b/rootdir/etc/init.ago.rc
index e203113..326e3ba 100644
--- a/rootdir/etc/init.ago.rc
+++ b/rootdir/etc/init.ago.rc
@@ -12,7 +12,7 @@ on post-fs-data && property:ro.crypto.state=unencrypted
 
 on post-fs-data
     write /proc/sys/vm/page-cluster 0
-    swapon_all /vendor/etc/fstab.enableswap
+    swapon_all /vendor/etc/fstab.mt6768
     write /dev/memcg/memory.swappiness 100
     write /dev/memcg/apps/memory.swappiness 100
     write /dev/memcg/system/memory.swappiness 100
diff --git a/rootdir/etc/init.mt6768.rc b/rootdir/etc/init.mt6768.rc
index c19e316..b2ba6ce 100644
--- a/rootdir/etc/init.mt6768.rc
+++ b/rootdir/etc/init.mt6768.rc
@@ -117,7 +117,6 @@ on fs
     write /sys/block/zram0/comp_algorithm zstd
     write /proc/sys/vm/page-cluster 0
     write /proc/sys/vm/swappiness 100
-    write /proc/sys/vm/direct_swappiness 60
     write /proc/sys/vm/vfs_cache_pressure 100
     write /proc/sys/vm/dirty_background_ratio 5
     write /proc/sys/vm/dirty_ratio 15
@@ -930,6 +929,13 @@ on property:sys.boot_completed=1
     write /proc/sys/net/core/default_qdisc fq
     write /proc/sys/net/ipv4/tcp_congestion_control bbr
 
+    # VM Memory Management (4GB LPDDR4X + 60% ZSTD ZRAM)
+    write /proc/sys/vm/watermark_scale_factor 150
+    write /proc/sys/vm/vfs_cache_pressure 100
+    write /proc/sys/vm/dirty_ratio 20
+    write /proc/sys/vm/dirty_background_ratio 5
+    write /proc/sys/vm/stat_interval 10
+
 #service dpfd /vendor/bin/dpfd
 #	user root
 #	group system media
@@ -1017,7 +1023,7 @@ service logger /system/bin/logcat -b all -D -f /cache/boot_log.txt
     disabled
     oneshot
 
-on post-fs-data
+on post-fs-data && property:persist.vendor.log.boot=1
     # Clear existing log and start the service
     rm /cache/boot_log.txt
     start logger
