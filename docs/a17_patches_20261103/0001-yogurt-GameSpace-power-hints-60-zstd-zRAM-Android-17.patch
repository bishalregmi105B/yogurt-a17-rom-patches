+vendor.camera.aux.packagelist=com.android.camera,com.google.camera,net.sourceforge.opencamera,org.lineageos.aperture,com.google.android.GoogleCamera,com.google.android.GoogleCameraEng,com.google.android.GoogleCameraGood,com.google.android.GoogleCamera.Urnyx,com.google.android.apps.cameralite
 
