From 64e5957b9850b87660f7c0e25841ce41e86fa83a Mon Sep 17 00:00:00 2001
From: Bishal Regmi <89974678+bishalregmi105B@users.noreply.github.com>
Date: Tue, 3 Nov 2026 22:06:22 +0545
Subject: [PATCH] yogurt: GameSpace power hints, 60% zstd zRAM, Android 17 LMKD
 PSI, GCam XML profile & camera permissions

---
 configs/camera/yogurt_s5kgm1_pro.xml          | 38 +++++++++++++++++++
 .../privapp-permissions-camera.xml            | 23 +++++++++++
 configs/power/powerscntbl.xml                 | 19 ++++++++++
 device.mk                                     |  2 +
 rootdir/etc/fstab.mt6768                      | 16 ++++----
 rootdir/etc/init.ago.rc                       |  2 +-
 rootdir/etc/init.mt6768.rc                    | 10 ++++-
 system.prop                                   |  4 +-
 vendor.prop                                   | 15 ++++----
 9 files changed, 108 insertions(+), 21 deletions(-)
 create mode 100644 configs/camera/yogurt_s5kgm1_pro.xml
 create mode 100644 configs/permissions/privapp-permissions-camera.xml

diff --git a/configs/camera/yogurt_s5kgm1_pro.xml b/configs/camera/yogurt_s5kgm1_pro.xml
new file mode 100644
index 0000000..0441fe5
--- /dev/null
+++ b/configs/camera/yogurt_s5kgm1_pro.xml
@@ -0,0 +1,38 @@
+<?xml version="1.0" encoding="utf-8" standalone="yes"?>
+<!--
+    Google Camera (BSG / LMC / Shamim) XML Configuration for Micromax IN Note 1 (yogurt)
+    SoC: MediaTek Helio G85 (MT6768)
+    Primary Sensor: 48 MP Samsung ISOCELL GM1 (S5KGM1ST / Tetracell) -> 12 MP default / 48 MP remosaic
+    Front Sensor: 16 MP Samsung S5K3P9SP
+    Ultrawide Sensor: 5 MP GalaxyCore GC5035
+    Macro Sensor: 2 MP GalaxyCore GC02M1
+-->
+<gcam_config>
+    <!-- Hardware Stream & Color Correction -->
+    <setting key="pref_c2api_stream_key" value="RAW10" />
+    <setting key="pref_black_level_key" value="64.0" />
+    <setting key="pref_black_level_front_key" value="64.0" />
+    <setting key="pref_color_model_key" value="s5kgm1" />
+    <setting key="pref_awb_model_key" value="pixel_3" />
+
+    <!-- HDR+ Frame Counts (Tuned for Helio G85 8-core CPU without capture lag) -->
+    <setting key="pref_hdr_frames_key" value="9" />
+    <setting key="pref_hdr_plus_enhanced_key" value="1" />
+    <setting key="pref_sabre_key" value="1" />
+    <setting key="pref_noise_reduction_key" value="2" />
+    <setting key="pref_sharpness_key" value="1.25" />
+    <setting key="pref_saturation_key" value="1.1" />
+
+    <!-- Aux Lens Mapping for Micromax IN Note 1 -->
+    <setting key="pref_aux_main_id" value="0" />
+    <setting key="pref_aux_front_id" value="1" />
+    <setting key="pref_aux_wide_id" value="3" />
+    <setting key="pref_aux_macro_id" value="4" />
+    <setting key="pref_aux_enable_key" value="1" />
+
+    <!-- Stabilization & Focus -->
+    <setting key="pref_optical_stabilization_key" value="0" />
+    <setting key="pref_electronic_stabilization_key" value="1" />
+    <setting key="pref_focus_tracking_key" value="1" />
+    <setting key="pref_motion_photo_key" value="0" />
+</gcam_config>
diff --git a/configs/permissions/privapp-permissions-camera.xml b/configs/permissions/privapp-permissions-camera.xml
new file mode 100644
index 0000000..2e3064b
--- /dev/null
+++ b/configs/permissions/privapp-permissions-camera.xml
@@ -0,0 +1,23 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Privileged app permissions for Camera packages (Aperture, Google Camera)
+-->
+<permissions>
+    <privapp-permissions package="org.lineageos.aperture">
+        <permission name="android.permission.CAMERA" />
+        <permission name="android.permission.RECORD_AUDIO" />
+        <permission name="android.permission.ACCESS_FINE_LOCATION" />
+        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
+        <permission name="android.permission.SYSTEM_CAMERA" />
+    </privapp-permissions>
+    <privapp-permissions package="com.android.camera">
+        <permission name="android.permission.CAMERA" />
+        <permission name="android.permission.RECORD_AUDIO" />
+        <permission name="android.permission.SYSTEM_CAMERA" />
+    </privapp-permissions>
+    <privapp-permissions package="com.google.android.GoogleCamera">
+        <permission name="android.permission.CAMERA" />
+        <permission name="android.permission.RECORD_AUDIO" />
+        <permission name="android.permission.SYSTEM_CAMERA" />
+    </privapp-permissions>
+</permissions>
diff --git a/configs/power/powerscntbl.xml b/configs/power/powerscntbl.xml
index d1d1554..3096a32 100644
--- a/configs/power/powerscntbl.xml
+++ b/configs/power/powerscntbl.xml
@@ -18,4 +18,23 @@
         <data cmd="PERF_RES_SCHED_UCLAMP_MIN_TA" param1="100"></data>
         <data cmd="PERF_RES_SCHED_CACHE_AUDIT" param1="1"></data>
     </scenario>
+    <!-- DerpFest GameSpace & Android Game Mode Performance -->
+    <scenario powerhint="FIXED_PERFORMANCE">
+        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1500000"></data>
+        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1800000"></data>
+        <data cmd="PERF_RES_CPUFREQ_MAX_CLUSTER_0" param1="3000000"></data>
+        <data cmd="PERF_RES_CPUFREQ_MAX_CLUSTER_1" param1="3000000"></data>
+        <data cmd="PERF_RES_SCHED_UCLAMP_MIN_TA" param1="80"></data>
+        <data cmd="PERF_RES_SCHED_BOOST_VALUE_ROOT" param1="30"></data>
+        <data cmd="PERF_RES_DRAM_OPP_MIN" param1="0"></data>
+        <data cmd="PERF_RES_GPU_GED_BENCHMARK_ON" param1="1"></data>
+        <data cmd="PERF_RES_GPU_GED_GX_BOOST" param1="1"></data>
+        <data cmd="PERF_RES_FPS_FBT_KMIN" param1="10"></data>
+    </scenario>
+    <!-- SurfaceFlinger Heavy Frame Render Boost -->
+    <scenario powerhint="EXPENSIVE_RENDERING">
+        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1400000"></data>
+        <data cmd="PERF_RES_SCHED_UCLAMP_MIN_TA" param1="60"></data>
+        <data cmd="PERF_RES_GPU_GED_GX_BOOST" param1="1"></data>
+    </scenario>
 </SCNTABLE>
